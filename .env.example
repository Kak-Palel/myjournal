# Copy to .env (never commit .env). Everything here is optional:
# you can configure the AI provider from the Settings page instead.

# --- Server ---------------------------------------------------------------
# PORT=3210
# HOST=127.0.0.1                 # keep loopback unless you set JOURNAL_PASSWORD
# JOURNAL_DATA_DIR=./data        # where journal.db lives
# JOURNAL_PASSWORD=              # required when HOST is not loopback
# JOURNAL_ALLOWED_HOSTS=         # extra Host header values, comma separated (reverse proxies)

# --- AI providers (fallbacks; a key saved in Settings wins over these) ----
# GEMINI_API_KEY=                # free key: https://aistudio.google.com/apikey
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # or OpenRouter / Groq / Together / ...
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1  # Ollama; llama.cpp: http://localhost:8080/v1; LM Studio: http://localhost:1234/v1
# LOCAL_LLM_MODEL=llama3.2:3b
# LOCAL_LLM_API_KEY=
