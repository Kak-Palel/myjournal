# MyJournal settings. Copy this file to ".env" (it is git-ignored; never commit it) and uncomment what you need.
# Everything is optional: AI keys and models can also be set in the app, under Settings.
#
# Where the file is read:
#   * npm start / node server.js : from the folder you start the server in (the current directory).
#     Variables that are already set in your real environment win over the file.
#   * Docker Compose            : from next to docker-compose.yml, to fill the ${...} placeholders in it.
#
# One setting per line, "NAME=value", no spaces around "=". Comment lines start with #.
# Put a value that contains # or $ in SINGLE quotes, for example  JOURNAL_PASSWORD='my pass#word$1'.
# Without quotes Node cuts the value at a # (it starts a comment) and Docker Compose also replaces $name,
# so the password would silently be shorter than the one you typed. Both read single quotes literally.
# Anything else (letters, digits, spaces, punctuation without # and $) needs no quotes.

# ==== Server ============================================================================================

# Port to listen on. 0 picks a free one.
# PORT=3210

# Address to listen on. 127.0.0.1 = this computer only (the default and the safe choice).
# 0.0.0.0 = every network interface. A non-loopback address makes MyJournal refuse to start unless
# JOURNAL_PASSWORD is set (or JOURNAL_INSECURE_ALLOW_NO_AUTH=1, below).
# HOST=127.0.0.1

# Folder that holds journal.db. A relative path is relative to the folder you start the server in.
# JOURNAL_DATA_DIR=./data

# Password to sign in. Use a long passphrase (remove the # in front of the line below to turn it on; quote it
# if it contains # or $, see the top of this file). Required when HOST is not a loopback address.
# The password and the session cookie travel unencrypted over plain http: for anything beyond
# your own computer put MyJournal behind an HTTPS reverse proxy.
# JOURNAL_PASSWORD=

# Extra "Host" header values to accept, comma separated, for example when a reverse proxy on the same
# computer forwards https://journal.example.com to MyJournal. "journal.example.com" accepts any port,
# "journal.example.com:8443" only that port. localhost, 127.0.0.1 and [::1] are always accepted.
# Only used while the Host check is on: whenever no password is set, and also when a password is set but
# HOST is a loopback address. With a password and a non-loopback HOST the check is off.
# JOURNAL_ALLOWED_HOSTS=journal.example.com

# Allow a non-loopback HOST without any password (1, true or yes). Only for setups where something else
# in front of MyJournal already does the login. Anyone who can reach the port can read the journal.
# JOURNAL_INSECURE_ALLOW_NO_AUTH=1

# ==== AI providers (all optional) =======================================================================
# A key you paste in Settings is stored in the journal database and wins over these variables.
# Keys given here stay in the environment: they are never written to the database.

# Free Gemini key from Google AI Studio: https://aistudio.google.com/apikey
# (GOOGLE_API_KEY is read as well, if GEMINI_API_KEY is not set.)
# GEMINI_API_KEY=

# OpenAI, or any OpenAI-compatible service (OpenRouter, Groq, Together, ...).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# A model on your own machine: Ollama, llama.cpp llama-server, LM Studio.
#   Ollama     http://localhost:11434/v1  (default)
#   llama.cpp  http://localhost:8080/v1
#   LM Studio  http://localhost:1234/v1
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.2:3b
# Only if your local server wants a key (Ollama does not).
# LOCAL_LLM_API_KEY=

# OPENAI_BASE_URL, LOCAL_LLM_BASE_URL and LOCAL_LLM_MODEL only provide the STARTING values of a FRESH
# install: one where no settings have been saved yet. The first Save (the welcome screen's first choice
# counts) stores the values shown in Settings in the database, and from then on these variables never
# override anything, so you can also pick the built-in default on purpose. Changing them later, or adding
# them to an existing install, has no effect: change the address and model in Settings instead.
# The API keys above are different: they are read on every start and are never stored.

# ==== Behind a company proxy ============================================================================
# Node's built-in fetch ignores HTTPS_PROXY unless NODE_USE_ENV_PROXY=1 is set (Node 22.21 or newer).
# Set these in the real environment of the process (shell, service file, compose "environment:"):
# putting NODE_USE_ENV_PROXY in this file is too late, Node has already started when the file is read.
#   NODE_USE_ENV_PROXY=1
#   HTTPS_PROXY=http://proxy.example.com:3128
#   NO_PROXY=localhost,127.0.0.1
# If the proxy re-signs HTTPS traffic, also point NODE_EXTRA_CA_CERTS at your company's CA file.

# ==== Docker Compose only (ignored by npm start) ========================================================
# docker-compose.yml reads these; the server settings above are fixed inside the container.

# Required by docker-compose.yml: JOURNAL_PASSWORD (above).

# Port on this computer's loopback that the container is published on.
# JOURNAL_HOST_PORT=3210

# Your time zone. The web app sends your browser's date, so the date the AI is told ("Today is ...") already
# matches your day; this only matters for other clients of the API that leave the date out, which then get the
# container's clock (UTC by default).
# TZ=Europe/Berlin

# Only with  docker compose --profile ollama up -d :
# the model to download into the bundled Ollama, and its context window in tokens.
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_CONTEXT_LENGTH=8192
